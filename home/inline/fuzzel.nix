{
  globalSection = {
    include = "/home/sanya/.config/fuzzel/theme.ini";
    font = "\"Iosevka Etoile:size=12\"";
    use-bold = "yes";
    terminal = "foot {cmd}";
    prompt = "\"Run: \"";
    placeholder = "\"There is nowhere to run.\"";
    icon-theme = "pixora";
    horizontal-pad = "30";
    line-height = "24";
    keyboard-focus = "exclusive";
    exit-on-keyboard-focus-loss = "yes";
  };

  sections = {
    border = {
      width = "4";
      radius = "20";
      selection-radius = "10";
    };
  };
}
